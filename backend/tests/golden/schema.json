{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CaixaClaro golden dataset v1",
  "type": "array",
  "minItems": 15,
  "items": {
    "type": "object",
    "required": [
      "id",
      "descricao",
      "valor",
      "categoria_esperada",
      "difficulty"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^g[0-9]{3,}$"
      },
      "descricao": {
        "type": "string",
        "minLength": 3
      },
      "valor": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]{2}$"
      },
      "categoria_esperada": {
        "type": "string",
        "minLength": 3
      },
      "difficulty": {
        "type": "string",
        "enum": [
          "easy",
          "medium",
          "hard",
          "adversarial"
        ]
      },
      "regra": {
        "type": "string"
      },
      "cpf_titular_hash": {
        "type": "string"
      },
      "cpf_contraparte_hash": {
        "type": "string"
      },
      "nota": {
        "type": "string"
      }
    }
  }
}